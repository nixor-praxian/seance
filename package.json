{
  "name": "seance",
  "version": "0.0.1",
  "description": "Summon and arrange Ghostty terminal panes into named groups, grids, and per-project themes.",
  "type": "module",
  "bin": {
    "seance": "./bin/seance.mjs"
  },
  "scripts": {
