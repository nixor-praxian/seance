{
  "name": "seance",
  "version": "2.2.5",
  "description": "Summonable workspace for Ghostty on macOS: auto-organize panes by repo, per-project colors, Alfred palette, self-healing watcher.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nixor-praxian/seance.git"
  },
  "keywords": ["ghostty", "macos", "window-management", "terminal", "alfred", "tiling"],
  "type": "module",
  "bin": {
    "seance": "./bin/seance.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
